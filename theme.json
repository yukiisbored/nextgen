	"displayName": "Cyberdream Light",
	"name": "cyberdream-light",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#a018ff",
		"interface": "#008c99",
		"namespace": "#a018ff",
		"property": "#008c99",
		"type": "#008c99"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": {
				"foreground": "#7b8496"
			}
		},
		{
			"scope": [
				"delimiter.bracket",
				"delimiter",
				"invalid.illegal.character-not-allowed-here.html",
				"keyword.operator.rest",
				"keyword.operator.spread",
				"keyword.operator.type.annotation",
				"keyword.operator.relational",
				"keyword.operator.assignment",
				"keyword.operator.type",
				"meta.brace",
				"meta.tag.block.any.html",
				"meta.tag.inline.any.html",
				"meta.tag.structure.input.void.html",
				"meta.type.annotation",
				"meta.embedded.block.github-actions-expression",
				"storage.type.function.arrow",
				"meta.objectliteral.ts",
				"punctuation",
				"punctuation.definition.string.begin.html.vue",
				"punctuation.definition.string.end.html.vue"
			],
			"settings": {
				"foreground": "#7b8496"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.language",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#d17c00"
			}
		},
		{
			"scope": ["entity", "entity.name"],
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": "variable.parameter.function",
			"settings": {
				"foreground": "#a018ff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["entity.name.tag", "tag.html"],
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type.class.jsdoc",
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#d17c00"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type",
				"support.type.builtin",
				"constant.language.undefined",
				"constant.language.null",
				"constant.language.import-export-all.ts"
			],
			"settings": {
				"foreground": "#f40064"
			}
		},
		{
			"scope": [
				"text.html.derivative",
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#16181a"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source",
				"attribute.value"
			],
			"settings": {
				"foreground": "#008b0c"
			}
		},
		{
			"scope": ["punctuation.definition.string"],
			"settings": {
				"foreground": "#008b0c88"
			}
		},
		{
			"scope": ["punctuation.support.type.property-name"],
			"settings": {
				"foreground": "#008c9988"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": [
				"property",
				"meta.property-name",
				"meta.object-literal.key",
				"entity.name.tag.yaml",
				"attribute.name"
			],
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"invalid.deprecated.entity.other.attribute-name.html"
			],
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": ["variable", "identifier"],
			"settings": {
				"foreground": "#16181a"
			}
		},
		{
			"scope": ["support.type.primitive", "entity.name.type"],
			"settings": {
				"foreground": "#a018ff"
			}
		},
		{
			"scope": "namespace",
			"settings": {
				"foreground": "#a018ff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.assignment.compound",
				"meta.var.expr.ts"
			],
			"settings": {
				"foreground": "#a018ff"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#f40064"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#f40064"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#f40064"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#f40064"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"background": "#f40064",
				"content": "^M",
				"fontStyle": "italic underline",
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#f40064"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#008b0c"
			}
		},
		{
			"scope": ["source.regexp", "string.regexp"],
			"settings": {
				"foreground": "#ff6e5e"
			}
		},
		{
			"scope": [
				"string.regexp.character-class",
				"string.regexp constant.character.escape",
				"string.regexp source.ruby.embedded",
				"string.regexp string.regexp.arbitrary-repitition"
			],
			"settings": {
				"foreground": "#008b0c"
			}
		},
		{
			"scope": "string.regexp constant.character.escape",
			"settings": {
				"foreground": "#d17c00"
			}
		},
		{
			"scope": ["support.constant"],
			"settings": {
				"foreground": "#d17c00"
			}
		},
		{
			"scope": [
				"keyword.operator.quantifier.regexp",
				"constant.numeric",
				"number"
			],
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": ["keyword.other.unit"],
			"settings": {
				"foreground": "#f40064"
			}
		},
		{
			"scope": ["constant.language.boolean", "constant.language"],
			"settings": {
				"foreground": "#d17c00"
			}
		},
		{
			"scope": "meta.module-reference",
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": {
				"foreground": "#f40064"
			}
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#d17c00"
			}
		},
		{
			"scope": "markup.quote",
			"settings": {
				"foreground": "#008c99",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#d17c00"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#d17c00"
			}
		},
		{
			"scope": "markup.raw",
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": [
				"markup.deleted",
				"meta.diff.header.from-file",
				"punctuation.definition.deleted"
			],
			"settings": {
				"background": "#f4006420",
				"foreground": "#f40064"
			}
		},
		{
			"scope": [
				"markup.inserted",
				"meta.diff.header.to-file",
				"punctuation.definition.inserted"
			],
			"settings": {
				"background": "#008b0c20",
				"foreground": "#008b0c"
			}
		},
		{
			"scope": ["markup.changed", "punctuation.definition.changed"],
			"settings": {
				"background": "#d17c0020",
				"foreground": "#d17c00"
			}
		},
		{
			"scope": ["markup.ignored", "markup.untracked"],
			"settings": {
				"background": "#0057d1",
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "meta.diff.range",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#a018ff"
			}
		},
		{
			"scope": "meta.diff.header",
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": "meta.separator",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#0057d1"
			}
		},
		{
			"scope": "meta.output",
			"settings": {
				"foreground": "#0057d1"
			}
		},
		{
			"scope": [
				"brackethighlighter.tag",
				"brackethighlighter.curly",
				"brackethighlighter.round",
				"brackethighlighter.square",
				"brackethighlighter.angle",
				"brackethighlighter.quote"
			],
			"settings": {
				"foreground": "#7b8496"
			}
		},
		{
			"scope": "brackethighlighter.unmatched",
			"settings": {
				"foreground": "#f40064"
			}
		},
		{
			"scope": [
				"constant.other.reference.link",
				"string.other.link",
				"punctuation.definition.string.begin.markdown",
				"punctuation.definition.string.end.markdown"
			],
			"settings": {
				"foreground": "#008b0c"
			}
		},
		{
			"scope": [
				"markup.underline.link.markdown",
				"markup.underline.link.image.markdown"
			],
			"settings": {
				"fontStyle": "underline",
				"foreground": "#0057d1"
			}
		},
		{
			"scope": ["type.identifier", "constant.other.character-class.regexp"],
			"settings": {
				"foreground": "#a018ff"
			}
		},
		{
			"scope": ["entity.other.attribute-name.html.vue"],
			"settings": {
				"foreground": "#008c99"
			}
		},
		{
			"scope": ["invalid.illegal.unrecognized-tag.html"],
			"settings": {
				"fontStyle": "normal"
			}
		}
	],
	"type": "light"
}
