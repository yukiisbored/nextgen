---
import type { CSSProperties } from "react";
import character from "../assets/character.png";
import circle from "../assets/circle.svg?raw";
import { Image } from "astro:assets";

interface Props {
  title?: string;
  author?: string;
  description?: string;
  image?: string;
  type?: string;
}

const defaults = {
  title: "yukiisbo.red",
  author: "Yuki Langley",
  description: "The personal website of a computer hobbyist dork",
  type: "website",
  image: "/profile.png",
};

const seo = {
  ...defaults,
  ...Astro.props,
  title: Astro.props.title
    ? `${Astro.props.title} | ${defaults.title}`
    : defaults.title,
  image: Astro.props.image
    ? new URL(Astro.url, Astro.props.image)
    : defaults.image,
};
const circleStyle = {
  backgroundImage: `url('data:image/svg+xml;base64,${btoa(circle)}')`,
  backgroundRepeat: "no-repeat",
  shapeOutside:
    "polygon(10.29% 19.72%, 4.41% 13.54%, 6.94% 7.98%, 5.65% 3.01%, 14.13% 4.64%, 19.65% 4.44%, 30.19% 5.58%, 39.87% 5.46%, 47.9% 5.2%, 62.08% 6.99%, 73.49% 11.46%, 80.88% 18.27%, 84.87% 24.17%, 86.53% 30.89%, 84.97% 39.12%, 82.17% 44.06%, 77.57% 48.45%, 76.39% 52.35%, 80.59% 55.6%, 91.52% 57.31%, 97.34% 62.57%, 93.05% 65.89%, 79.51% 67.85%, 82.23% 82.03%, 82.43% 94.54%, 81.92% 98.15%, 66.74% 74.15%, 56.76% 81.13%, 40.69% 82.62%, 21.17% 78.5%, 36.25% 64.87%, 35.59% 58.05%, 23.01% 50.68%, 11.22% 40.76%, 7.81% 28.38%)",
  shapeMargin: "2.5rem",
} satisfies CSSProperties;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Yuki's Notes"
      href="/rss.xml"
    />

    <title>{seo.title}</title>

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seo.description} />
    <meta name="image" content={seo.image} />
    <meta name="author" content={seo.author} />

    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:url" content={Astro.url} />
  </head>
  <body>
    <div
      class="absolute top-0 left-0 right-0 h-16 -z-10 flex flex-col justify-end bg-yuki"
    >
      <p
        class="mx-auto max-w-5xl text-right font-mono text-white w-full pr-5 z-10"
      >
        yukiisbo.red
      </p>
    </div>
    <div class="p-4 mt-5 mx-auto max-w-5xl">
      <div
        class="float-none md:float-left w-full md:w-[400px] h-fit"
        style={circleStyle}
      >
        <Image
          src={character}
          alt="Drawing of my character by Luciel Teo"
          class="filter drop-shadow-lg"
          loading="eager"
        />
      </div>

      <header class="flex flex-col items-end text-right mt-8">
        <h2 class="text-8xl font-bold">
          {Astro.props.title ?? defaults.title}
        </h2>
      </header>

      <slot />
    </div>
    <div class="bg-yuki">
      <footer
        id="footer"
        class="max-w-5xl mx-auto p-4 py-8 text-white grid grid-cols-3 grid-rows-1 gap-8"
      >
        <div class="flex flex-col gap-4">
          <h1 class="font-bold">Hello world! I'm Yuki Langley.</h1>
          <p>
            This is my small corner on the internet where I write about things
            that matters to me.
          </p>
          <p>At the moment, I'm not active in any of the social medias.</p>
          <p>
            If you'd like to contact me, you can email me via <code
              class="font-mono">hi</code
            > at this website.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <ul class="border-b pb-4">
            <li>
              <a href="/notes">Notes</a>,
            </li>
            <li>
              <a href="https://github.com/yuki_is_bored">Code</a>,
            </li>
            <li>
              <a href="https://yukiisbored.itch.io">Games</a>.
            </li>
          </ul>
          <ul>
            <li>
              <a href="/notes/coop-games">Co-op games list</a>.
            </li>
          </ul>
        </div>
        <div class="flex flex-col gap-4">
          <p>
            Character art by <a href="https://twitter.com/Luciel_Teo"
              >Luciel Teo</a
            ><br />
            <a href="https://creativecommons.org/licenses/by-sa/4.0/"
              >CC BY-SA 4.0</a
            >
          </p>
          <p>
            All writings are typed by my own hands done with a computer
            keyboard.<br />
            <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/">
              CC BY-NC-ND 4.0
            </a>.
          </p>
          <p>
            This website layout is inspired by <a
              href="https://journal.stuffwithstuff.com/"
              >Bob Nystrom's Journal</a
            >. He's a cool guy who wrote <a
              href="https://craftinginterpreters.com/"
              >Crafting Interpreters
            </a> and is working on <a href="https://dart.dev/">Dart</a>.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  a {
    @apply text-yuki hover:text-yuki-dark active:underline focus:underline font-medium;
  }

  footer a {
    @apply text-white hover:text-white font-bold underline;
  }

  .prose-yuki {
    @apply prose prose-a:text-yuki prose-a:no-underline hover:prose-a:text-yuki-dark prose-h1:text-yuki prose-h2:text-yuki prose-h3:text-yuki prose-h4:text-yuki;
    max-width: inherit;
  }

  .prose-yuki video {
    @apply w-full aspect-video;
  }

  .prose-yuki iframe {
    @apply w-full;
  }

  .prose-yuki code:not(pre code) {
    @apply text-yuki;
  }

  .og-card-container {
    @apply my-6;
  }

  .og-card-container > a {
    @apply flex flex-row items-stretch no-underline rounded-lg border border-yuki/30 overflow-hidden bg-white text-inherit font-normal transition-colors hover:bg-yuki/5 hover:border-yuki focus:bg-yuki/5 focus:border-yuki;
  }

  .og-card-info {
    @apply flex flex-col flex-1 min-w-0 p-4 gap-1;
  }

  .og-card-title {
    @apply font-semibold text-base md:text-lg text-yuki-dark line-clamp-2;
  }

  .og-card-description {
    @apply text-sm text-gray-600 line-clamp-2;
  }

  .og-card-url-container {
    @apply flex flex-row items-center gap-2 mt-auto pt-2 min-w-0;
  }

  .og-card-favicon {
    @apply w-4 h-4 m-0 flex-shrink-0;
  }

  .og-card-url {
    @apply text-xs text-gray-500 truncate;
  }

  .og-card-image-container {
    @apply hidden md:block flex-shrink-0 w-48 bg-yuki/5;
  }

  .og-card-image {
    @apply w-full h-full object-cover m-0;
  }
</style>
