---
import clsx from "clsx";

type AdmonitionType = "tip" | "note" | "warning" | "danger";

export interface Props {
  type: AdmonitionType;
  title?: string;
}

const { type, title } = Astro.props;

const emojiMap = {
  tip: "💡",
  note: "ℹ️",
  warning: "🚸",
  danger: "🚫",
};

const colorMap = {
  tip: "bg-green-100 border-green-500 text-green-800",
  note: "bg-blue-100 border-blue-500 text-blue-800",
  warning: "bg-yellow-100 border-yellow-500 text-yellow-800",
  danger: "bg-red-100 border-red-500 text-red-800",
};

const defaultTitles = {
  tip: "Tip",
  note: "Note",
  warning: "Warning",
  danger: "Danger",
};

const admonitionTitle = title || defaultTitles[type];
const emoji = emojiMap[type];
const colorClasses = colorMap[type];
---

<div class={clsx("p-4 my-4 border-l-4 rounded-r", colorClasses)}>
  <div class="flex items-center mb-2">
    <span class="text-xl mr-2" role="img" aria-label={type}>{emoji}</span>
    <h3 class="font-bold text-lg">{admonitionTitle}</h3>
  </div>
  <div class="ml-7">
    <slot />
  </div>
</div>


