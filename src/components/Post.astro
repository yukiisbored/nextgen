---
import { render, type getCollection } from "astro:content";
import Admonition from "./Admonition.astro";

type Post = Awaited<ReturnType<typeof getCollection<"notes">>>[0];

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const tableOfContents =
  headings.length > 0
    ? {
        items: headings
          .filter((heading) => heading.depth === 1)
          .map((heading) => ({
            url: `#${heading.slug}`,
            title: heading.text,
          })),
      }
    : null;
---

<div class="text-right">
  {
    new Date(post.data.date).toLocaleString(undefined, {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  }
</div>

<div class="sticky hidden xl:block top-4 -mt-6">
  {
    tableOfContents && tableOfContents.items.length > 0 && (
      <nav class="absolute right-[100%] mr-8 w-max text-right" id="toc">
        <h2 class="font-bold text-2xl md:text-3xl">Table of Contents</h2>
        <ul class="pl-10 mt-2">
          {tableOfContents.items.map((item) => (
            <li>
              <a href={item.url} class="transition-all">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>

<script>
  // https://stackoverflow.com/a/75346369
  const anchors = document.querySelectorAll("h1");
  const links = document.querySelectorAll("#toc > ul > li > a");

  window.addEventListener("scroll", (event) => {
    const classes = [
      "text-xl",
      "font-bold",
      "italic",
      "bg-yuki",
      "text-white",
      "hover:text-white",
    ];
    if (
      typeof anchors != "undefined" &&
      anchors != null &&
      typeof links != "undefined" &&
      links != null
    ) {
      let scrollTop = window.scrollY;

      // highlight the last scrolled-to: set everything inactive first
      links.forEach((link, index) => {
        classes.forEach((clazz) => link.classList.remove(clazz));
      });

      // then iterate backwards, on the first match highlight it and break
      for (var i = anchors.length - 1; i >= 0; i--) {
        if (scrollTop > anchors[i].offsetTop - 75) {
          classes.forEach((clazz) => links[i].classList.add(clazz));
          break;
        }
      }
    }
  });
</script>

{
  post.data.draft && (
    <Admonition type="warning" title="This is a draft, do not share">
      This post is a draft and is subject to change. Please don't share it on
      social media nor quote/cite it as a source.
    </Admonition>
  )
}

<article class="prose-yuki mt-10">
  <Content />
</article>
