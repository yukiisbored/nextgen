---
import { Image } from "astro:assets";

import character from "../assets/character.png";
import circle from "../assets/circle.svg?raw";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Post from "../components/Post.astro";
import type { CSSProperties } from "react";

const circleStyle = {
  backgroundImage: `url('data:image/svg+xml;base64,${btoa(circle)}')`,
  backgroundRepeat: "no-repeat",
  shapeOutside:
    "polygon(0.04% 0.16%, 80.74% 0.31%, 80.88% 18.27%, 84.87% 24.17%, 86.53% 30.89%, 84.97% 39.12%, 82.17% 44.06%, 77.57% 48.45%, 76.39% 52.35%, 80.59% 55.6%, 87.27% 59.09%, 90.55% 63.47%, 79.51% 67.85%, 76.48% 86.07%, 77.68% 95.83%, 77.67% 100.9%, -1.76% 100.98%, 0% 50%)",
  shapeMargin: "1.5rem",
} satisfies CSSProperties;

const post = (await getCollection("notes"))
  .filter((post) => !post.data.draft)
  // @ts-expect-error This works as intended.
  .toSorted((a, b) => new Date(b.data.date) - new Date(a.data.date))[0];
---

<Layout title={post.data.title}>
  <div class="relative hidden xl:block">
    <nav
      class="absolute -top-0.5 left-[100%] ml-8 w-max text-gray-500 flex flex-col gap-4"
    >
      <p>Looking for something else?</p>
      <ul>
        <li>
          <a href="#footer">Check the footer</a>,
        </li>
        <li>
          <a href="/notes">See past notes</a>.
        </li>
      </ul>
      <p>Have fun.</p>
    </nav>
  </div>
  <article>
    <Post post={post} />
  </article>

  <style is:global>
    .about h1 {
      @apply text-2xl font-bold;
    }

    .about h1 a {
      @apply text-2xl font-bold;
    }

    .about ul {
      @apply list-disc pl-10 mt-2 text-xl;
    }

    .about li {
      @apply mt-2;
    }
  </style>
</Layout>
