---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("notes");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Create table of contents from headings
const tableOfContents =
	headings.length > 0
		? {
				items: headings
					.filter((heading) => heading.depth === 1)
					.map((heading) => ({
						url: `#${heading.slug}`,
						title: heading.text,
					})),
			}
		: null;
---

<Layout title={post.data.title}>
  <div class="flex flex-col">
    <header>
      <div class="text-right text-sm md:text-xs">
        <a href="/notes">INDEX</a>
        {" | "}
        <a href="/">HOME</a>
      </div>
      <div class="text-center mt-10">
        <h1 class="font-bold text-yuki text-3xl md:text-6xl">
          {post.data.title}
        </h1>
        <p class="text-xl text-yuki-dark font-medium mt-4">
          Published on {post.data.date}
        </p>
      </div>
    </header>

    {tableOfContents && tableOfContents.items.length > 0 && (
      <section class="mt-4">
        <h2 class="font-bold text-2xl md:text-3xl text-yuki">
          Table of Contents
        </h2>
        <ul class="list-decimal pl-10 mt-2">
          {tableOfContents.items.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <article class="prose-yuki mt-4">
      <Content />
    </article>

    <footer class="mt-4">
      <a href="/notes">← Return to notes</a>
    </footer>
  </div>
</Layout>
