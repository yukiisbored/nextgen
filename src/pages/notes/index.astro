---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import removeMd from "remove-markdown";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("notes");

const groupedPosts = posts
  .filter((post) => !post.data.draft)
  .reduce(
    (acc, post) => {
      const year = new Date(post.data.date).getFullYear();
      if (!acc[year]) {
        acc[year] = [];
      }
      acc[year].push(post);
      return acc;
    },
    {} as Record<number, CollectionEntry<"notes">[]>,
  );

const sortedYears = Object.keys(groupedPosts).sort(
	(a, b) => Number(b) - Number(a),
);

const stripMarkdown = (markdown: string) => {
	return removeMd(markdown).replace(/\s+/g, " ").trim().slice(0, 150);
};
---

<Layout title="Notes">
  <div class="flex flex-col">
    <div class="text-right text-sm md:text-xs">
      <a href="/">HOME</a>
    </div>
    <header class="text-center">
      <h1 class="font-bold text-yuki text-7xl">Yuki's Notes</h1>
      <p class="text-xl text-yuki-dark font-medium mt-4">
        The writings of a computer hobbyist dork
      </p>
    </header>
    <section class="mt-4">
      {sortedYears.map(year => (
        <div class="mt-1">
          <h2 class="font-bold text-yuki text-4xl">
            {year}
          </h2>
          <ul class="mt-4">
            {groupedPosts[Number(year)]
              .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
              .map((post) => (
                <li class="mt-6 pb-6 border-b border-gray-100 last:border-0 md:mt-1 md:pb-0 md:border-0">
                  <div class="flex flex-col md:grid md:grid-cols-[9ch_1fr] md:gap-x-2">
                    <div class="hidden md:block md:order-1">{post.data.date}</div>
                    <div class="md:order-2">
                      <a href={`/notes/${post.slug}`} class="text-2xl md:text-base font-medium">
                        {post.data.title}
                      </a>
                      <div class="text-sm text-gray-500 mt-2 mb-3 md:mt-1 md:mb-1 md:hidden">{post.data.date}</div>
                      {(post.data.description || post.body) && (
                        <p class="mt-3 md:mt-2 md:mb-2">
                          {post.data.description || stripMarkdown(post.body)}
                        </p>
                      )}
                    </div>
                  </div>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Layout>
