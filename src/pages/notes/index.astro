---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { description } from "../../utils/seo";

const posts = await getCollection("notes");

const groupedPosts = posts
  .filter((post) => !post.data.draft)
  .reduce(
    (acc, post) => {
      const year = new Date(post.data.date).getFullYear();
      if (!acc[year]) {
        acc[year] = [];
      }
      acc[year].push(post);
      return acc;
    },
    {} as Record<number, CollectionEntry<"notes">[]>,
  );

const sortedYears = Object.keys(groupedPosts).sort(
  (a, b) => Number(b) - Number(a),
);

const months = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const shortDate = (date: string) => {
  const d = new Date(date);
  return `${months[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;
};
---

<Layout title="Notes">
  <div class="flex flex-col">
    {
      sortedYears.map((year) => (
        <div class="mt-1">
          <h2 class="font-bold text-yuki text-4xl">{year}</h2>
          <ul class="mt-4">
            {groupedPosts[Number(year)]
              .sort(
                (a, b) =>
                  new Date(b.data.date).getTime() -
                  new Date(a.data.date).getTime(),
              )
              .map((post) => (
                <li class="mt-6 pb-6 border-b border-gray-100 last:border-0 md:mt-4 md:pb-0 md:border-0">
                  <div class="flex flex-col md:grid md:grid-cols-[6ch_1fr] md:gap-x-6 md:items-baseline">
                    <div class="hidden md:block text-sm text-gray-500">
                      {shortDate(post.data.date)}
                    </div>
                    <div>
                      <a
                        href={`/notes/${post.id}`}
                        class="text-2xl md:text-xl font-medium"
                      >
                        {post.data.title}
                      </a>
                      <div class="text-sm text-gray-500 mt-2 mb-3 md:hidden">
                        {post.data.date}
                      </div>
                      {(post.data.description || post.body) && (
                        <p class="mt-3 md:mt-2 md:mb-2">
                          {post.data.description || description(post.body!)}
                        </p>
                      )}
                    </div>
                  </div>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
</Layout>
